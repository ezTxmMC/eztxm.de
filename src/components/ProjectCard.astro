---
import { Icon } from "astro-icon/components";

interface Props {
    name: string;
    description: string;
    tags: string[];
    status: "active" | "wip" | "archived";
    github?: string;
    url?: string;
    color?: "primary" | "secondary" | "accent" | "purple";
}

const {
    name,
    description,
    tags,
    status,
    github,
    url,
    color = "primary",
} = Astro.props;

const statusMap = {
    active:   { label: "Active",    class: "text-secondary border-secondary bg-secondary-bg" },
    wip:      { label: "In progress", class: "text-accent border-accent bg-accent-bg" },
    archived: { label: "Archived",  class: "text-text-dim border-border bg-surface-raised" },
};

const colorMap = {
    primary:   "bg-primary",
    secondary: "bg-secondary",
    accent:    "bg-accent",
    purple:    "bg-purple",
};

const s = statusMap[status];
---

<div class="group relative flex flex-col rounded-lg border border-border bg-surface-raised overflow-hidden transition-all duration-200 ease-in-out hover:border-border-bright hover:bg-surface-bright">
    <!-- Top accent bar -->
    <div class={`h-0.5 w-full ${colorMap[color]}`} />

    <div class="flex flex-col flex-1 p-6 gap-4">
        <!-- Header -->
        <div class="flex items-start justify-between gap-md">
            <h3 class="font-semibold text-text leading-snug">{name}</h3>
            <span class={`shrink-0 text-xs px-2 py-0.5 rounded-full border ${s.class}`}>
                {s.label}
            </span>
        </div>

        <!-- Description -->
        <p class="text-sm text-text-muted leading-relaxed flex-1">{description}</p>

        <!-- Tags -->
        <div class="flex flex-wrap gap-xs">
            {tags.map((tag) => (
                <span class="text-xs px-2 py-0.5 rounded-md border border-border bg-surface text-text-dim">
                    {tag}
                </span>
            ))}
        </div>

        <!-- Links -->
        {(github || url) && (
            <div class="flex items-center gap-sm pt-2 border-t border-border">
                {github && (
                    <a
                        href={github}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="GitHub"
                        class="flex items-center gap-xs text-xs text-text-dim transition-colors duration-200 ease-in-out hover:text-text"
                    >
                        <Icon name="simple-icons:github" class="w-3.5 h-3.5" />
                        Source
                    </a>
                )}
                {url && (
                    <a
                        href={url}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Live site"
                        class="flex items-center gap-xs text-xs text-text-dim transition-colors duration-200 ease-in-out hover:text-text"
                    >
                        <Icon name="lucide:external-link" class="w-3.5 h-3.5" />
                        Live
                    </a>
                )}
            </div>
        )}
    </div>
</div>
