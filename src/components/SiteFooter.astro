---
import { Icon } from 'astro-icon/components';

class Link {
    constructor(
        public href: string,
        public label: string,
        public external: boolean = false,
    ) {}
}

class SocialLink {
    constructor(
        public icon: string,
        public href: string,
        public label: string,
    ) {}
}

const socialLinks = [
    new SocialLink('simple-icons:github', 'https://github.com/ezTxmMC', 'GitHub'),
    new SocialLink('simple-icons:youtube', 'https://youtube.com/@ezTxmMC', 'YouTube'),
    new SocialLink('simple-icons:twitch', 'https://twitch.tv/eztxmmc', 'Twitch'),
    new SocialLink('simple-icons:bluesky', 'https://bsky.app/profile/eztxm.de', 'Bluesky'),
];

const pagesLinks = [
    new Link('/#about', 'About'),
    new Link('/#skills', 'Skills'),
    new Link('/projects', 'Projects'),
    new Link('/#contact', 'Contact'),
];

const servicesLinks = [
    new Link('https://status.eztxm.de', 'Status', true),
    new Link('https://repo.eztxm.de', 'Repository', true),
    new Link('https://bluenet-hosting.com', 'Hosting', true),
];

const legalLinks = [new Link('/imprint', 'Imprint')];
---

<footer class="border-t border-t-border/50 backdrop-blur-md" style="background: color-mix(in srgb, var(--color-bg) 70%, transparent)">
    <div class="px-6 md:px-12 lg:px-50 py-12 grid grid-cols-2 sm:grid-cols-4 gap-xl">
        <!-- Brand -->
        <div class="flex flex-col gap-sm">
                <span class="font-semibold text-text">ezTxmMC</span>
            <p class="text-sm text-text-muted leading-relaxed">Modern software solutions.</p>
            <div class="flex items-center gap-sm mt-2">
                {
                    socialLinks.map((link) => (
                        <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={link.label}
                            class="p-2 rounded-md text-text-muted border border-border bg-surface-raised transition-all duration-200 ease-in-out hover:text-primary hover:border-primary hover:bg-primary-bg"
                        >
                            <Icon name={link.icon} class="w-4 h-4" />
                        </a>
                    ))
                }
            </div>
        </div>

        <!-- Pages -->
        <div class="flex flex-col gap-xs">
            <p class="text-xs font-semibold uppercase tracking-widest text-text-dim mb-2">Pages</p>
            {
                pagesLinks.map((link) => (
                    <a href={link.href} class="text-sm text-text-muted transition-colors duration-200 ease-in-out hover:text-text w-fit">
                        {link.label}
                    </a>
                ))
            }
        </div>

        <!-- Services -->
        <div class="flex flex-col gap-xs">
            <p class="text-xs font-semibold uppercase tracking-widest text-text-dim mb-2">Services</p>
            {
                servicesLinks.map((link) => (
                    <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-sm text-text-muted transition-colors duration-200 ease-in-out hover:text-text w-fit"
                    >
                        {link.label}
                    </a>
                ))
            }
        </div>

        <!-- Legal -->
        <div class="flex flex-col gap-xs">
            <p class="text-xs font-semibold uppercase tracking-widest text-text-dim mb-2">Legal</p>
            {
                legalLinks.map((link) => (
                    <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-sm text-text-muted transition-colors duration-200 ease-in-out hover:text-text w-fit"
                    >
                        {link.label}
                    </a>
                ))
            }
        </div>
    </div>

    <!-- Bottom bar -->
    <div class="px-6 md:px-12 lg:px-50 py-4 border-t border-t-border/50 flex items-center justify-center sm:justify-between">
        <p class="text-xs text-text-dim text-center">
            &copy; {new Date().getFullYear()} ezTxmMC. All rights reserved.
        </p>
    </div>
</footer>
