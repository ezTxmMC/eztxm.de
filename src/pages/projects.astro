---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { Icon } from 'astro-icon/components';

const projects = [
    {
        name: 'Portfolio',
        description: 'Personal portfolio website built with Astro and Tailwind CSS. Showcases projects, skills, and contact info.',
        tags: ['Astro', 'TypeScript', 'Tailwind'],
        status: 'active' as const,
        github: 'https://github.com/ezTxmMC/eztxm.de',
        url: 'https://eztxm.de',
    },
    {
        name: 'BlueNet-Hosting',
        description: 'Hosting service for gamers and developers offering reliable infrastructure without the noise.',
        tags: ['Infrastructure', 'Linux', 'Nginx', 'Docker'],
        status: 'wip' as const,
        url: 'https://bluenet-hosting.com',
    },
    {
        name: 'VoltLauncher',
        description:
            'A performant, lightweight, simple and functional minecraft launcher for common loaders and modding platforms written in java and vue.',
        tags: ['Minecraft'],
        status: 'wip' as const,
        github: 'https://github.com/Volt-Launcher',
        url: 'https://volt-launcher.app',
    },
    {
        name: 'Novus',
        description:
            'Modern programming language currently being developed in C++ with the goal of eventually becoming self-hosted (capable of compiling itself), featuring a modern syntax and design.',
        tags: ['C++', 'Programming language', 'Lexer', 'Parser'],
        status: 'wip' as const,
        github: 'https://github.com/Novus-lang',
    },
    {
        name: 'LuckPrefix',
        description: 'The luckperms addon for tab- and chat-prefixes in Minecraft on the market.',
        tags: ['Java', 'Minecraft', 'Paper'],
        status: 'archived' as const,
        github: 'https://github.com/ezTxmMC/LuckPrefix',
        url: 'https://modrinth.com/plugin/luckprefix',
    },
];

const CARD_COLORS = ['primary', 'secondary', 'accent', 'purple'] as const;
---

<SiteLayout title="Projects — ezTxmMC">
    <!-- Page header -->
    <section
        class="relative px-6 md:px-12 lg:px-50 pt-20 pb-16 border-b border-b-border overflow-hidden"
        style="background: radial-gradient(ellipse 60% 80% at 50% -20%, var(--color-primary-glow), transparent)"
    >
        <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-4">Work</p>
        <h1 class="text-4xl md:text-5xl font-bold text-text mb-4 leading-tight">Projects</h1>
        <p class="text-text-muted max-w-5xl leading-relaxed">A collection of things I've built — from personal tools to production services.</p>
    </section>

    <!-- Filters -->
    <section class="px-6 md:px-12 lg:px-50 pt-16">
        <div data-filter-bar class="flex flex-wrap gap-sm">
            {
                (
                    [
                        { key: 'all', label: 'All', count: projects.length },
                        { key: 'active', label: 'Active', count: projects.filter((p) => p.status === 'active').length },
                        { key: 'wip', label: 'In progress', count: projects.filter((p) => p.status === 'wip').length },
                        { key: 'archived', label: 'Archived', count: projects.filter((p) => p.status === 'archived').length },
                    ] as const
                )
                    .filter((f) => f.key === 'all' || f.count > 0)
                    .map((f) => (
                        <button
                            type="button"
                            data-filter={f.key}
                            aria-pressed={f.key === 'all'}
                            class="px-4 py-2 rounded-full border text-sm font-medium transition-all duration-200 ease-in-out border-border bg-surface-raised text-text-muted hover:text-text hover:border-border-bright aria-pressed:bg-primary aria-pressed:border-primary aria-pressed:text-white"
                        >
                            {f.label}
                            <span class="ml-1 opacity-60">{f.count}</span>
                        </button>
                    ))
            }
        </div>
    </section>

    <!-- Grid -->
    <section class="px-6 md:px-12 lg:px-50 py-16">
        <div data-animate-stagger class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-lg">
            {projects.map((p, i) => <ProjectCard {...p} color={CARD_COLORS[i % CARD_COLORS.length]} />)}
        </div>
        <p data-filter-empty class="hidden text-center text-text-muted py-16">No projects match this filter.</p>
    </section>

    <script>
        function initProjectFilter() {
            const bar = document.querySelector('[data-filter-bar]');
            const cards = document.querySelectorAll<HTMLElement>('[data-project-card]');
            const empty = document.querySelector('[data-filter-empty]');
            if (!bar || bar.hasAttribute('data-filter-init')) return;
            bar.setAttribute('data-filter-init', 'true');

            bar.addEventListener('click', (e) => {
                const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
                if (!btn) return;

                bar.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
                btn.setAttribute('aria-pressed', 'true');

                const filter = btn.dataset.filter;
                let visibleCount = 0;
                cards.forEach((card) => {
                    const match = filter === 'all' || card.dataset.status === filter;
                    card.classList.toggle('hidden', !match);
                    if (match) visibleCount++;
                });
                empty?.classList.toggle('hidden', visibleCount > 0);
            });
        }

        initProjectFilter();
        document.addEventListener('astro:page-load', initProjectFilter);
    </script>

    <!-- GitHub CTA -->
    <section class="px-6 md:px-12 lg:px-50 pb-16">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-md px-6 sm:px-8 py-6 rounded-lg border border-border bg-surface-raised">
            <div class="flex flex-col gap-1">
                <p class="font-medium text-text">More on GitHub</p>
                <p class="text-sm text-text-muted">Browse all my repos, contributions, and experiments.</p>
            </div>
            <a
                href="https://github.com/ezTxmMC"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto justify-center flex items-center gap-sm px-5 py-2.5 rounded-md border border-border-bright bg-surface-bright text-text-muted text-sm font-medium transition-all duration-200 ease-in-out hover:text-text hover:border-primary hover:bg-primary-bg"
            >
                <Icon name="simple-icons:github" class="w-4 h-4" />
                github.com/ezTxmMC
            </a>
        </div>
    </section>
</SiteLayout>
